{
  "manifest_version": 3,
  "name": "Server Flip",
  "version": "1.1.0",
  "description": "One click to bounce the current page between staging and local dev servers. Learns your projects from their canonical URLs.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Flip between staging and local",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "flip-server": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Flip between staging and local"
    }
  }
}